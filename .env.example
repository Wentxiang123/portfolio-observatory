# 将下方需要的项目追加到现有 .env；不要覆盖已有 DATABASE_URL。
# DATABASE_URL=postgresql+psycopg://portfolio_owner:YOUR_PASSWORD@127.0.0.1:55432/portfolio

# SMTP：保留供未来邮箱验证使用。v0.4 不启用邮件认证，无须填写。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# SMTPS 则设置 SMTP_SECURITY=ssl 和 SMTP_PORT=465。
# 不支持明文 SMTP；请按服务商要求填写授权码，而非在聊天中提供密码。

# 旧邮箱模块 APP_SECRET 保留；当前 TOTP 使用独立 DPAPI 保护的加密密钥。
# 已有值及 var/private/auth-secret 请保留，未来邮箱模块可能继续使用。
# APP_SECRET=
COOKIE_SECURE=false
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
AUTO_QUOTES=true
